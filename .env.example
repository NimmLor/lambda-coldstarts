# Copy to .env (git ignores it) for local deploys and benchmarks. `sst deploy` loads .env from
# next to sst.config.ts, and Bun loads it for `bun run bench`.

# AWS credentials: either a profile from ~/.aws/config (SSO included; `aws sso login` first) ...
AWS_PROFILE=
# ... or static keys. AWS_SESSION_TOKEN only for temporary credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_REGION=eu-central-1

# Deploy settings, see the README. `bun run deploy` sets LAMBDA_ARCH and BUN_BUNDLES itself.
# LAMBDA_ARCH=x86_64
# LAMBDA_MEMORY=1769
# VARIANTS=BunCompile,Node24
# BUN_AOT_BIN=/home/you/.bun-aot/bun-linux-x64/bun   # absolute: .env expands no ~
# PERF_ROUNDS=10
# PERF_CONCURRENCY=4
# PERF_SCHEDULE=rate(12 hours)
