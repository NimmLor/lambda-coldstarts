{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    // Resolves every `/// <reference types="node" />` to one of these two copies. Without
    // .sst/platform's, the @grpc/grpc-js inside SST's platform brings its own @types/node 20, whose
    // `Buffer` clashes with the ESNext lib and breaks .sst/platform/src/components/aws/function.ts.
    "typeRoots": ["node_modules/@types", ".sst/platform/node_modules/@types"],
    "types": ["bun", "aws-lambda"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "infra", "scripts", "sst.config.ts"]
}
