{
  "name": "bun-aot-lambda",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "sst deploy",
    "remove": "sst remove",
    "bench": "bun scripts/bench.ts",
    "build:local": "bun scripts/build-local.ts",
    "build": "bun scripts/build-docker.ts",
    "explain": "bun scripts/explain.ts",
    "deploy:docker": "bun run build && LAMBDA_ARCH=x86_64,arm64 BUN_BUNDLES=dist sst deploy",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sst": "4.17.2"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1158.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
